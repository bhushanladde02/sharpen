# Caddy terminates TLS (Let's Encrypt, automatic) and proxies to the app.
{$DOMAIN} {
    encode gzip zstd
    reverse_proxy app:8080
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

# Optional extra site blocks — e.g. redirects from an old name or www — live in deploy/caddy-extra/*.caddy
# (git-ignored; see legacy-redirect.caddy.example). Nothing there is fine: a glob that matches nothing is skipped.
import /etc/caddy/extra/*.caddy
