# Copy to deploy/.env and fill in. Never commit .env.
DOMAIN=sharpen.example.com
DB_PASSWORD=change-me-to-something-long
ADMIN_EMAIL=you@example.com
DEMO_DATA=false
# On a 1 GB machine (Oracle E2.1.Micro) set this to true: adds deploy/docker-compose.micro.yml (smaller JVM/DB).
SMALL_VM=false
# "Continue with Google / GitHub" (optional). Leave empty to offer only email and password. Setup steps:
# docs/deployment/05-day-two.rst, "Sign in with Google and GitHub". Callback URLs:
#   https://<DOMAIN>/login/oauth2/code/google   and   https://<DOMAIN>/login/oauth2/code/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
